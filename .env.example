# Wardhook environment configuration.
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# Nothing in this repository hardcodes a credential; every key below is read
# from the environment at call time.

# ---------------------------------------------------------------------------
# Model provider credentials (only the one you actually use is required)
# ---------------------------------------------------------------------------
# Default provider for `AgentGraph(model="claude-opus-5")`.
# Requires: pip install "wardhook-core[anthropic]"
ANTHROPIC_API_KEY=

# Optional alternative providers. wardhook-core is provider-agnostic: pass any
# langchain-core BaseChatModel to AgentGraph and none of these are needed.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# wardhook-core :: serve
# ---------------------------------------------------------------------------
WARDHOOK_HOST=127.0.0.1
WARDHOOK_PORT=8000
# Comma-separated origins for CORS on the served agent. Empty disables CORS.
WARDHOOK_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# wardhook-guardrails
# ---------------------------------------------------------------------------
# Entity pack used when none is passed explicitly: default|insurance|healthcare|fintech
WARDHOOK_ENTITY_PACK=default
# Where the compliance audit log is written (JSONL, one event per line).
WARDHOOK_AUDIT_LOG=audit-logs/wardhook-audit.jsonl

# ---------------------------------------------------------------------------
# wardhook-observability
# ---------------------------------------------------------------------------
WARDHOOK_TRACE_DIR=traces
# Override the built-in per-1M-token pricing table with your own JSON file.
WARDHOOK_PRICING_FILE=
