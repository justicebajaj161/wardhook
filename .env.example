# Wardhook environment configuration.
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# Nothing in this repository hardcodes a credential; every key below is read
# from the environment at call time.
#
# Every variable listed here is one that something in this repository actually
# reads. Wardhook deliberately has no hidden environment configuration: the
# library is configured through its constructors, so that a call site tells you
# what it will do without you also having to know the environment it runs in.

# ---------------------------------------------------------------------------
# Model provider credentials (only the one you actually use is required)
# ---------------------------------------------------------------------------
# Read by the provider's own client, not by Wardhook. `AgentGraph(model=...)`
# resolves a name like "claude-opus-5" to langchain-anthropic, which then picks
# this up itself. Needed by examples/core_rag_agent.py in its --live mode only;
# every example runs offline against a fake model by default.
# Requires: pip install "wardhook-core[anthropic]"
ANTHROPIC_API_KEY=

# The same applies to the other providers Wardhook can resolve a name for.
# wardhook-core is provider-agnostic: pass any langchain-core BaseChatModel to
# AgentGraph and none of these are needed.
# Requires: pip install "wardhook-core[openai]"
OPENAI_API_KEY=
# Requires: pip install "wardhook-core[google]"
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# wardhook-core :: the `wardhook serve` command
# ---------------------------------------------------------------------------
# Defaults for `wardhook serve`; both are overridden by --host and --port.
# 127.0.0.1 keeps the agent off the network unless you say otherwise.
WARDHOOK_HOST=127.0.0.1
WARDHOOK_PORT=8000
# Comma-separated origins for CORS on the served agent. Empty disables CORS.
WARDHOOK_CORS_ORIGINS=
# Turn on the read-only dashboard at /dashboard. Off unless this is 1/true/yes/on
# or --dashboard is passed. Serving it on a non-loopback interface needs a
# second, separate opt-in (--dashboard-allow-remote) -- which includes the
# container image below, since that binds 0.0.0.0.
WARDHOOK_DASHBOARD=

# ---------------------------------------------------------------------------
# wardhook-core :: the container image
# ---------------------------------------------------------------------------
# Read only by packages/wardhook-core/Dockerfile, which passes it to
# `wardhook serve`. The agent to serve, as module:attribute.
WARDHOOK_TARGET=agent:agent

# ---------------------------------------------------------------------------
# Deliberately absent
# ---------------------------------------------------------------------------
# There is no environment variable for the entity pack, the audit log path, the
# trace directory, or the pricing table. Each is a constructor argument instead
# -- PIIRedactor(pack=...), AuditLogger(path), JSONLTraceStore(path),
# register_price(...) -- because a guardrail whose behaviour depends on ambient
# environment state is one you cannot review by reading the call site.
